// 本番（molten-scorelink.firebasestorage.app）で稼働中のルールの控え。
// 2026-08-16 にコンソールの本文と突き合わせて一致を確認済み。
// 変更するときはコンソールとこのファイルの両方を必ず揃えること。
// https://console.firebase.google.com/project/molten-scorelink/storage/rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 紙のスコアシート写真
    // - 閲覧：誰でも可（速報ページで表示するため）
    // - 保存：編集者（app_config/editors の許可リスト）のみ
    // - 画像ファイルのみ・1枚10MBまで
    match /score_sheets/{gameId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email.lower() in
           firestore.get(/databases/(default)/documents/app_config/editors).data.emails
        && (request.resource == null
            || (request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // それ以外は全拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
